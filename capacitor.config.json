{
  "appId": "com.bebranova.nocturne",
  "appName": "Nocturne Writer",
  "webDir": "dist",
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0e0e12",
    "captureInput": true
  },
  "plugins": {
    "StatusBar": { "style": "DARK", "backgroundColor": "#0e0e12" },
    "CapacitorHttp": { "enabled": false }
  }
}
